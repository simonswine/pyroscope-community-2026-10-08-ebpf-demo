#!/usr/bin/env bpftrace
// Run from the project root: bpftrace examples/stacks.bt
// Leave the Go workload running in another session.
// Native stacks only; requires kernel BTF for curtask->tgid.
// Discover host PIDs from the binary's uprobe, not from /proc or comm.
uprobe:./examples/workload:main.helloWorld
{
    @targets[curtask->tgid] = 1;
}

profile:hz:490
/@targets[curtask->tgid]/
{
    @stacks[ustack(20)] = count();
}

tracepoint:sched:sched_process_exit
/curtask->pid == curtask->tgid/
{
    delete(@targets[curtask->tgid]);
}

interval:s:10 { exit(); }
END { clear(@targets); }
