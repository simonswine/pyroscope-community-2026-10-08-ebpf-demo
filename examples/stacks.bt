#!/usr/bin/env bpftrace
// Run after discovery: sudo bpftrace examples/stacks.bt "$WORKLOAD_PID"
// Native stacks only; requires kernel BTF for curtask->tgid.
// $1 is the kernel PID emitted by discover.bt, not a container-visible PID.
profile:hz:490
/(uint64)curtask->tgid == $1/
{
    @stacks[ustack(20)] = count();
}
interval:s:10 { exit(); }
