#!/usr/bin/env bpftrace
// Run from the project root: bpftrace examples/writes.bt
// Leave the Go workload running in another session.
// Register processes executing this exact binary, without /proc discovery.
// Requires kernel BTF for curtask->tgid; no PID namespace helper is used.
uprobe:./examples/workload:main.helloWorld
{
    @targets[curtask->tgid] = 1;
}

tracepoint:syscalls:sys_enter_write
/@targets[curtask->tgid]/
{
    @writes = count();
}

tracepoint:sched:sched_process_exit
/curtask->pid == curtask->tgid/
{
    delete(@targets[curtask->tgid]);
}

interval:s:10 { exit(); }
END { clear(@targets); }
