#!/usr/bin/env bpftrace
// Run: sudo bpftrace examples/uprobe.bt
// Scoped to this executable file; includes all its running instances.
// Emits a tracing message without altering the Go process output.
uprobe:./examples/workload:main.helloWorld
{
    printf("eBPF observed: helloWorld() called\n");
    @calls = count();
}
interval:s:10 { exit(); }
